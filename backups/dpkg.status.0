Depends: libc6 (>= 2.34), libegl1, libfreetype6 (>= 2.2.1), libgcc-s1 (>= 3.3.1), libgles2 (>= 1.0.0), libstdc++6 (>= 13.1), libx11-6, libxmu6 (>= 2:1.1.3)
